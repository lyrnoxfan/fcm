---
const { title = 'FocusGuard Console' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f7f8" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
